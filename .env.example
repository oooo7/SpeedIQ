# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only; required for webhooks and cron (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp webhook verification (Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Cron: used by /api/cron/whatsapp-send to validate requests. Supabase cron (pg_cron) calls this endpoint every minute; store the same value in app_cron_config.bearer_token (see docs/cron-supabase.md).
CRON_SECRET=your-cron-secret

