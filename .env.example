# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only; required for webhooks and cron (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- WhatsApp ---
# Webhook: set in Meta → WhatsApp → Configuration → Webhook. Must match the "Verify token" you type there.
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Embedded Signup (optional): for "Connect with WhatsApp" in app. Get from Meta Developer Portal.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
WHATSAPP_CONFIG_ID=your-embedded-signup-config-id
WHATSAPP_SOLUTION_ID=

# App URL for callbacks and cron. e.g. https://yourapp.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000/

# Cron: same secret as in Supabase app_cron_config.bearer_token for whatsapp_send. See docs/cron-supabase.md.
CRON_SECRET=your-cron-secret

# Email: choose provider with EMAIL_PROVIDER=resend or EMAIL_PROVIDER=smtp. If SMTP_HOST is set, SMTP is used even without EMAIL_PROVIDER.
EMAIL_PROVIDER=resend

# Resend (when EMAIL_PROVIDER=resend): get API key at https://resend.com
RESEND_API_KEY=re_your-api-key

# SMTP (when EMAIL_PROVIDER=smtp or SMTP_HOST is set): use your own mail server or any SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From address (e.g. notifications@yourdomain.com). For Resend use a verified domain; for SMTP use an address your server allows.
EMAIL_FROM=notifications@yourdomain.com
# Main sending domain: used for platform fallback addresses (e.g. acme@send.habiv.com). Set once here; used everywhere. Must be verified in Resend.
EMAIL_FALLBACK_DOMAIN=send.habiv.com
# Optional: secret for signing unsubscribe links. If unset, CRON_SECRET is used.
UNSUBSCRIBE_SECRET=

# --- Twilio SMS (Platform-managed) ---
# Account SID: Twilio Console → Account Dashboard (starts with AC...)
TWILIO_ACCOUNT_SID=
# Auth Token: Twilio Console → Account Dashboard (used for webhook signature validation)
TWILIO_AUTH_TOKEN=

# OAuth App credentials (recommended for Twilio API calls):
# Twilio Console → Admin → Account management → Keys & credentials → OAuth apps
TWILIO_OAUTH_CLIENT_ID=
TWILIO_OAUTH_CLIENT_SECRET=
# Optional scope override for token request (leave blank to use Twilio app defaults)
TWILIO_OAUTH_SCOPE=

# Public URLs configured in Twilio webhooks:
# Messaging Service/Phone Number inbound webhook URL
TWILIO_INBOUND_WEBHOOK_URL=
# Status callback URL for outbound delivery updates
TWILIO_STATUS_CALLBACK_URL=

# --- Stripe (billing) ---
# Stripe API keys: https://dashboard.stripe.com/apikeys (use test keys for dev: sk_test_, pk_test_)
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Stripe price IDs per plan, currency, and cycle (set after creating products in Stripe dashboard)
STRIPE_PRICE_STARTER_MONTHLY_INR=
STRIPE_PRICE_STARTER_YEARLY_INR=
STRIPE_PRICE_STARTER_MONTHLY_USD=
STRIPE_PRICE_STARTER_YEARLY_USD=
STRIPE_PRICE_PRO_MONTHLY_INR=
STRIPE_PRICE_PRO_YEARLY_INR=
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_PRO_YEARLY_USD=
STRIPE_PRICE_BUSINESS_MONTHLY_INR=
STRIPE_PRICE_BUSINESS_YEARLY_INR=
STRIPE_PRICE_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_BUSINESS_YEARLY_USD=
# Credit top-up pack price IDs (one-time payments)
STRIPE_PRICE_CREDITS_5K_INR=
STRIPE_PRICE_CREDITS_25K_INR=
STRIPE_PRICE_CREDITS_100K_INR=
STRIPE_PRICE_CREDITS_500K_INR=
STRIPE_PRICE_CREDITS_5K_USD=
STRIPE_PRICE_CREDITS_25K_USD=
STRIPE_PRICE_CREDITS_100K_USD=
STRIPE_PRICE_CREDITS_500K_USD=
