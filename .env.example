# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only; required for webhooks and cron (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp webhook verification (Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-verify-token

# WhatsApp Embedded Signup (Meta Developer Portal)
# Required for automatic WhatsApp account connection via OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
WHATSAPP_CONFIG_ID=your-embedded-signup-config-id
# Optional: Solution ID for partners
WHATSAPP_SOLUTION_ID=
# Optional: Base URL for redirect callback (e.g. https://speediq.vercel.app). If unset, frontend uses current origin.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cron: used by /api/cron/whatsapp-send to validate requests. Supabase cron (pg_cron) calls this endpoint every minute; store the same value in app_cron_config.bearer_token (see docs/cron-supabase.md).
CRON_SECRET=your-cron-secret

# Email: choose provider with EMAIL_PROVIDER=resend or EMAIL_PROVIDER=smtp. If SMTP_HOST is set, SMTP is used even without EMAIL_PROVIDER.
EMAIL_PROVIDER=resend

# Resend (when EMAIL_PROVIDER=resend): get API key at https://resend.com
RESEND_API_KEY=re_your-api-key

# SMTP (when EMAIL_PROVIDER=smtp or SMTP_HOST is set): use your own mail server or any SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From address (e.g. notifications@yourdomain.com). For Resend use a verified domain; for SMTP use an address your server allows.
EMAIL_FROM=notifications@yourdomain.com
# Main sending domain: used for platform fallback addresses (e.g. acme@send.habiv.com). Set once here; used everywhere. Must be verified in Resend.
EMAIL_FALLBACK_DOMAIN=send.habiv.com
# Optional: secret for signing unsubscribe links. If unset, CRON_SECRET is used.
UNSUBSCRIBE_SECRET=

