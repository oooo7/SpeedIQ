# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only; required for webhooks and cron (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp webhook verification (Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Cron: set in Vercel so scheduled campaign sends run. Vercel sends this as Bearer token when invoking /api/cron/whatsapp-send.
CRON_SECRET=your-cron-secret

